# 换行与编码按文件类型统一，避免 Windows 检出 / Linux 检出的差异
* text=auto eol=lf

*.cpp    text eol=lf
*.h      text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.qrc    text eol=lf
*.sh     text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# PowerShell 脚本必须 CRLF + UTF-8 BOM，否则 PowerShell 5.1 按 GBK 解码中文
*.ps1    text eol=crlf
# 批处理必须 CRLF + GBK
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制
*.png    binary
*.gif    binary
*.ico    binary
*.exe    binary
*.dll    binary
*.zip    binary
*.tar.gz binary